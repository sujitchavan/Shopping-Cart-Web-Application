# Netlify / Cloudflare Pages security headers. Keep in sync with vercel.json and vite.config.ts.
/*
  Content-Security-Policy: default-src 'self'; img-src 'self' https://fakestoreapi.com; connect-src 'self' https://fakestoreapi.com; script-src 'self'; style-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=63072000; includeSubDomains

/assets/*
  Cache-Control: public, max-age=31536000, immutable
